# ---- DATABASE ----
# Postgres is required everywhere. Start a local one with
# `docker-compose up -d postgres && pnpm db:migrate`.
DATABASE_URL=postgres://localhost:5432/dev_dives
DATABASE_USER=dives_user
DATABASE_PASSWORD=dives

# ---- EMAIL ----
# Leaving these unset disables email sending gracefully (isMailerConfigured()
# gate no-ops). Dive backup emails are enqueued regardless and simply stay
# pending until SMTP is configured.
email_host=smtp.protonmail.ch
email_port=587
email_use_starttls=true
email_host_user=zulu@aleksandr.vin
email_host_password=

# ---- AUTH ----
# Authentik (OIDC) is the only sign-in path unless PASSWORD_AUTH_ENABLED=true.
AUTHENTIK_ISSUER=
AUTHENTIK_CLIENT_ID=
AUTHENTIK_CLIENT_SECRET=
# PASSWORD_AUTH_ENABLED=true

# ---- HEALTHCHECK ----
HEALTHCHECK_PING_URL=
HEALTHCHECK_PING_INTERVAL_SECONDS=60

# ---- APP ----
NEXT_PUBLIC_BASE_URL=http://localhost:3000
APP_VERSION=0.0.0
DIVES_ADMIN_EMAIL=admin@aleksandr.vin
DIVES_ADMIN_PASSWORD=change-me

# ---- PADI ----
# AES-256-GCM key for encrypting stored PADI OAuth tokens at rest (see scripts/padi/crypto.mjs),
# base64-encoded, must decode to exactly 32 bytes -- generate with `openssl rand -base64 32`.
# Read lazily (on first PADI connect/sync/refresh), not required for the app to boot or for
# unrelated pages/tests to work.
PADI_TOKEN_ENCRYPTION_KEY=
# Only set during an active key rotation: lets decryptSecret fall back to the old key for
# already-stored tokens while new writes use PADI_TOKEN_ENCRYPTION_KEY. Remove once rotation
# completes.
PADI_TOKEN_ENCRYPTION_KEY_PREVIOUS=
# HMAC pepper for hashing the PADI username used in rate-limit rows (lib/padi/rate-limit.ts) --
# without this, "the plaintext PADI username is never stored" would be an unsalted/unpeppered
# SHA-256, trivially reversible against a candidate email list.
PADI_USERNAME_HASH_PEPPER=
